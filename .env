# =============================================
# 海運運價預測系統 — 環境變數設定檔
# =============================================

# --- Kafka ---
KAFKA_BROKER=kafka:9092
KAFKA_TOPIC_METRICS=shipping-metrics
KAFKA_TOPIC_NEWS=shipping-news

# --- Elasticsearch ---
ES_HOST=http://elasticsearch:9200
ES_INDEX_NEWS=shipping-news-index
ES_INDEX_VECTORS=shipping-vectors

# --- InfluxDB ---
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=shipping-super-secret-token
INFLUXDB_ORG=shipping-org
INFLUXDB_BUCKET=shipping-metrics

# --- MinIO ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_RAW=raw-data
MINIO_BUCKET_MODELS=model-artifacts

# --- Flink ---
FLINK_JOBMANAGER=flink-jobmanager:6123
FLINK_PARALLELISM=1

# --- Dashboard ---
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
